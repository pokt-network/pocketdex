#####################################################################
# Network selector - pocketdex comes with mainnet and beta ready to use
# with public RPCs
#####################################################################

#NETWORK=mainnet

# localnet runs its own validator in the local cluster (tilt/localnet).
# Alternatively uncomment ENDPOINT and point to an external fullnode using http://IP:PORT to the RPC,
# with GENESIS_PATH set to its genesis.

#####################################################################
# PgAdmin email and password
#####################################################################

#PGADMIN_ENABLED=yes
#PGADMIN_EMAIL=pocketdex@local.dev
#PGADMIN_PASSWORD=pocketdex

#####################################################################
# Only for used when NETWORK=localnet
#####################################################################

# Relative to the repo root; an absolute path does not work (tilt joins it with the repo path).
# Defaults to the localnet validator's genesis, tilt/localnet/validator/genesis.json.
#GENESIS_PATH=tilt/localnet/validator/genesis.json

#####################################################################
# All this allow on the fly overides without modify kustomize files.
#####################################################################

#NODE_OPTIONS=--max-old-space-size=16384
#CHAIN_ID=
#ENDPOINT=http://your-full-node-ip:26657
#BATCH_SIZE=10
#START_BLOCK=1
# Defaults shown. POCKETDEX_DB_PAGE_LIMIT must not exceed the node's --query-limit, or SubQuery throws.
#POCKETDEX_DB_BATCH_SIZE=5000
#POCKETDEX_DB_PAGE_LIMIT=1000
#POCKETDEX_DB_BULK_WRITE_CONCURRENCY=5
# Per-attempt timeout (ms) of the mappings' ABCI queries (3 attempts); default 120000.
#POCKETDEX_ABCI_TIMEOUT_MS=120000
# Set to "true" only for local testing — forces application reconcile every block.
# In production leave unset or set to "false". Validators are always reconciled
# every block, so they have no flag.
#POCKETDEX_RECONCILE_APPLICATIONS_EVERY_BLOCK=false
#PG_POOL_MIN=50
#PG_POOL_MAX=75
#PG_POOL_ACQUIRE=5000
#PG_POOL_IDLE=10000
#PG_POOL_EVICT=15000
